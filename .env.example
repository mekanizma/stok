# Supabase (Vite build-time — Render'da Environment Variables olarak da ekleyin)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Local / script secrets (never commit real values)
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
ADMIN_EMAIL=admin@stoktakip.com
ADMIN_PASSWORD=

# Stock alerts (Supabase Dashboard > Edge Functions > Secrets)
# RESEND_API_KEY=re_xxx
# Deploy: npx supabase functions deploy stock-alert --project-ref <ref>

# Render Web Service:
#   Root Directory: (bos)
#   Build Command: npm ci && npm run build
#   Start Command: npm start
# Env (build sirasinda gerekli):
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
