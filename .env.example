# Supabase (Vite build-time — Render'da Environment Variables olarak da ekleyin)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Render: New > Blueprint > bu repo, veya Static Site:
#   Build Command: npm ci && npm run build
#   Publish Directory: dist
#   Rewrite: /* -> /index.html
# Env (build sırasında gerekli):
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
